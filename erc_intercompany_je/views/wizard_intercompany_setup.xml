<odoo>

    <record id="view_wizard_intercompany_setup_form" model="ir.ui.view">
        <field name="name">wizard.intercompany.setup.form</field>
        <field name="model">wizard.intercompany.setup</field>
        <field name="arch" type="xml">
            <form string="Batch Intercompany Setup">
                <group>
                    <field name="company_ids" widget="many2many_tags"/>
                    <field name="force_realign"/>
                </group>
                <group>
                    <field name="preview_text" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_run_setup"
                        type="object"
                        string="Run Setup"
                        class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_wizard_intercompany_setup" model="ir.actions.act_window">
        <field name="name">Batch Intercompany Setup</field>
        <field name="res_model">wizard.intercompany.setup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
